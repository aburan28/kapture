# syntax=docker/dockerfile:1
FROM golang:1.26-bookworm AS agent-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/kapture-agent ./cmd/capture-agent

FROM golang:1.26-bookworm AS ecapture-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git ca-certificates pkg-config libelf-dev llvm-14 clang-14 \
    bpftool flex bison file && rm -rf /var/lib/apt/lists/*
WORKDIR /ecapture-src
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca; fi; \
    git init && git remote add origin https://github.com/gojue/ecapture.git && \
    git fetch --depth=1 origin afcc9345ff8f09f96811a158cf768d284b4c7e1b && \
    git checkout --detach FETCH_HEAD && git submodule update --init --recursive
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca; fi; \
    make clean && make core CMD_CLANG=clang-14 CMD_LLC=llc-14 CMD_STRIP=llvm-strip-14

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    openssl libelf1 && rm -rf /var/lib/apt/lists/*
COPY --from=agent-builder /out/kapture-agent /kapture-agent
COPY --from=ecapture-builder /ecapture-src/bin/ecapture /ecapture
COPY --from=ecapture-builder /ecapture-src/LICENSE /usr/share/doc/ecapture/LICENSE
LABEL io.kapture.ecapture.revision="afcc9345ff8f09f96811a158cf768d284b4c7e1b"
ENTRYPOINT ["/kapture-agent"]
