+// SPDX-License-Identifier: Apache-2.0
+package openssl
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+)
+
+func TestKaptureInlineSocketContext(t *testing.T) {
+	prefix := benchmarkTLSDataSample(t)
+	var footer bytes.Buffer
+	var source, destination [16]byte
+	copy(source[:], []byte{127, 0, 0, 1})
+	copy(destination[:], []byte{127, 0, 0, 2})
+	for _, field := range []any{uint64(123), source, destination, uint16(2), uint16(443), uint16(30000), uint16(2)} {
+		if err := binary.Write(&footer, binary.LittleEndian, field); err != nil {
+			t.Fatal(err)
+		}
+	}
+	sample := append(append([]byte(nil), prefix...), footer.Bytes()...)
+	var event Event
+	if err := event.DecodeFromBytes(append(sample, make([]byte, 8)...)); err != nil {
+		t.Fatal(err)
+	}
+	if !event.inlineNetwork || event.GetSrcIP() != "127.0.0.1" || event.GetDstIP() != "127.0.0.2" || event.GetSrcPort() != 443 || event.GetDstPort() != 30000 || event.GetStreamID() == "" {
+		t.Fatalf("inline metadata lost: %+v", event)
+	}
+	id := event.GetStreamID()
+	event.connectionID++
+	if event.GetStreamID() == id {
+		t.Fatal("reused fd/tuple kept the old socket identity")
+	}
+	for _, bad := range [][]byte{sample[:len(prefix)+16], append(append([]byte(nil), sample[:len(sample)-2]...), 3, 0)} {
+		if err := new(Event).DecodeFromBytes(bad); err == nil {
+			t.Fatal("partial/unsupported network footer accepted")
+		}
+	}
+}
