+// SPDX-License-Identifier: Apache-2.0
+package openssl
+
+import (
+	"debug/elf"
+	"os"
+	"reflect"
+	"testing"
+)
+
+func TestKaptureDirectCallInstructionBoundaries(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		code    []byte
+		address uint64
+		want    []uint64
+		bad     bool
+	}{
+		{"relative forward", []byte{0xe8, 11, 0, 0, 0, 0xc3}, 0x1000, []uint64{0x1010}, false},
+		{"relative backward", []byte{0xe8, 0xfb, 0xff, 0xff, 0xff, 0xc3}, 0x1000, []uint64{0x1000}, false},
+		{"CALL byte inside MOV immediate", []byte{0xb8, 0xe8, 0, 0, 0, 0xc3}, 0x1000, nil, false},
+		{"indirect call cannot identify helper", []byte{0xff, 0xd0, 0xc3}, 0x1000, nil, false},
+		{"truncated call", []byte{0xe8, 0}, 0x1000, nil, true},
+		{"underflow", []byte{0xe8, 0xf0, 0xff, 0xff, 0xff}, 0, nil, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := directCalls(test.code, test.address)
+			if (err != nil) != test.bad || !reflect.DeepEqual(got, test.want) {
+				t.Fatalf("calls=%v error=%v", got, err)
+			}
+		})
+	}
+}
+
+func TestKaptureExecutableFileOffsets(t *testing.T) {
+	f := &elf.File{Progs: []*elf.Prog{{ProgHeader: elf.ProgHeader{Type: elf.PT_LOAD, Flags: elf.PF_R | elf.PF_X, Vaddr: 0x2000, Off: 0x1000, Filesz: 128}}, {ProgHeader: elf.ProgHeader{Type: elf.PT_LOAD, Flags: elf.PF_R | elf.PF_W, Vaddr: 0x3000, Off: 0x2000, Filesz: 128}}}}
+	if got, ok := executableOffset(f, 0x2042); !ok || got != 0x1042 {
+		t.Fatalf("wrong file mapping: %x %t", got, ok)
+	}
+	for _, address := range []uint64{0x1fff, 0x2080, 0x3000} {
+		if _, ok := executableOffset(f, address); ok {
+			t.Fatalf("non-executable or out-of-file address accepted: %x", address)
+		}
+	}
+}
+
+func TestKaptureOpenSSL30LibraryHelpers(t *testing.T) {
+	path := os.Getenv("ECAPTURE_TEST_SSL_LIBRARY")
+	if path == "" {
+		t.Skip("set ECAPTURE_TEST_SSL_LIBRARY to select a real OpenSSL 3.0 ELF")
+	}
+	read, write, err := openssl30InternalOffsets(path)
+	if err != nil || read == 0 || write == 0 || read == write {
+		t.Fatalf("cannot identify independent read/write helpers: read=%x write=%x err=%v", read, write, err)
+	}
+	t.Logf("OpenSSL 3.0 helper file offsets: read=%x write=%x", read, write)
+}
+
+func TestKaptureRejectsInvalidHelperELF(t *testing.T) {
+	file, err := os.CreateTemp(t.TempDir(), "not-elf")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = file.WriteString("invalid ELF"); err != nil {
+		t.Fatal(err)
+	}
+	file.Close()
+	if _, _, err := openssl30InternalOffsets(file.Name()); err == nil {
+		t.Fatal("invalid ELF accepted")
+	}
+}
