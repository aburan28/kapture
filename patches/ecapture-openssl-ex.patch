new file mode 100644
index 0000000..9318503
--- /dev/null
+++ b/internal/probe/openssl/internal_offsets.go
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: Apache-2.0
+package openssl
+
+import (
+	"debug/elf"
+	"fmt"
+	"io"
+	"strings"
+
+	"golang.org/x/arch/x86/x86asm"
+)
+
+// OpenSSL 3.0 SSL BIO callbacks bypass the exported SSL APIs and call the
+// same private helpers as SSL_read[_ex]/SSL_write[_ex]. Resolve those helpers
+// from both public wrappers, without fixed offsets or byte-pattern searches.
+// Unsupported layouts fail before attachment rather than guessing an ABI.
+func openssl30InternalOffsets(path string) (uint64, uint64, error) {
+	f, err := elf.Open(path)
+	if err != nil {
+		return 0, 0, err
+	}
+	defer f.Close()
+	if f.Machine != elf.EM_X86_64 || f.Class != elf.ELFCLASS64 {
+		return 0, 0, fmt.Errorf("OpenSSL 3.0 BIO helpers require a supported x86-64 ELF layout")
+	}
+	symbols, err := f.DynamicSymbols()
+	if err != nil {
+		return 0, 0, err
+	}
+	find := func(name string) (elf.Symbol, error) {
+		for _, s := range symbols {
+			if s.Name == name && s.Section != elf.SHN_UNDEF && elf.ST_TYPE(s.Info) == elf.STT_FUNC && s.Size > 0 && s.Size <= 512 {
+				return s, nil
+			}
+		}
+		return elf.Symbol{}, fmt.Errorf("missing or unsupported %s wrapper", name)
+	}
+	private := func(address uint64) bool {
+		if _, ok := executableOffset(f, address); !ok {
+			return false
+		}
+		for _, s := range symbols {
+			if s.Section != elf.SHN_UNDEF && s.Value == address {
+				return false
+			}
+		}
+		for _, section := range f.Sections {
+			if strings.Contains(section.Name, "plt") && address >= section.Addr && address-section.Addr < section.Size {
+				return false
+			}
+		}
+		return true
+	}
+	helper := func(api string) (uint64, error) {
+		var calls [2][]uint64
+		for i, name := range []string{api, api + "_ex"} {
+			symbol, err := find(name)
+			if err != nil {
+				return 0, err
+			}
+			code := make([]byte, symbol.Size)
+			var reader io.ReaderAt
+			var relative uint64
+			for _, p := range f.Progs {
+				if p.Type == elf.PT_LOAD && p.Flags&elf.PF_X != 0 && symbol.Value >= p.Vaddr && symbol.Value-p.Vaddr < p.Filesz && symbol.Size <= p.Filesz-(symbol.Value-p.Vaddr) {
+					reader, relative = p, symbol.Value-p.Vaddr
+					break
+				}
+			}
+			if reader == nil {
+				return 0, fmt.Errorf("%s wrapper outside executable segment", name)
+			}
+			if _, err := reader.ReadAt(code, int64(relative)); err != nil {
+				return 0, err
+			}
+			calls[i], err = directCalls(code, symbol.Value)
+			if err != nil {
+				return 0, err
+			}
+		}
+		var matches []uint64
+		for _, a := range calls[0] {
+			if !private(a) {
+				continue
+			}
+			for _, b := range calls[1] {
+				if a == b {
+					unique := true
+					for _, old := range matches {
+						if old == a {
+							unique = false
+						}
+					}
+					if unique {
+						matches = append(matches, a)
+					}
+				}
+			}
+		}
+		if len(matches) != 1 {
+			return 0, fmt.Errorf("%s wrappers do not uniquely identify a private helper", api)
+		}
+		offset, ok := executableOffset(f, matches[0])
+		if !ok {
+			return 0, fmt.Errorf("helper outside executable file data")
+		}
+		return offset, nil
+	}
+	read, err := helper("SSL_read")
+	if err != nil {
+		return 0, 0, err
+	}
+	write, err := helper("SSL_write")
+	if err != nil {
+		return 0, 0, err
+	}
+	if read == write {
+		return 0, 0, fmt.Errorf("read and write helpers unexpectedly coincide")
+	}
+	return read, write, nil
+}
+
+func executableOffset(f *elf.File, address uint64) (uint64, bool) {
+	for _, p := range f.Progs {
+		if p.Type == elf.PT_LOAD && p.Flags&elf.PF_X != 0 && address >= p.Vaddr && address-p.Vaddr < p.Filesz {
+			return p.Off + (address - p.Vaddr), true
+		}
+	}
+	return 0, false
+}
+
+func directCalls(code []byte, address uint64) ([]uint64, error) {
+	var calls []uint64
+	for offset := 0; offset < len(code); {
+		instruction, err := x86asm.Decode(code[offset:], 64)
+		if err != nil || instruction.Len == 0 || instruction.Op == 0 {
+			return nil, fmt.Errorf("invalid wrapper instruction")
+		}
+		if instruction.Op == x86asm.CALL {
+			if relative, ok := instruction.Args[0].(x86asm.Rel); ok {
+				pc := address + uint64(offset+instruction.Len)
+				if relative < 0 && uint64(-int64(relative)) > pc {
+					return nil, fmt.Errorf("relative call underflow")
+				}
+				calls = append(calls, uint64(int64(pc)+int64(relative)))
+			}
+		}
+		offset += instruction.Len
+	}
+	return calls, nil
+}
