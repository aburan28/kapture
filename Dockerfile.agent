FROM golang:1.25 AS builder

WORKDIR /src
COPY . .

ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/kapture-agent ./cmd/capture-agent

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/kapture-agent /kapture-agent
ENTRYPOINT ["/kapture-agent"]